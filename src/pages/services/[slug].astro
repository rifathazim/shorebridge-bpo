---
import Base from '../../layouts/Base.astro';
import ServicePage from '../../layouts/ServicePage.astro';
import { SERVICES } from '../../data/services';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return SERVICES.map((svc) => ({ params: { slug: svc.slug }, props: { svc } }));
}

const { svc } = Astro.props;
const path = `/services/${svc.slug}/`;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: svc.name,
  name: svc.h1,
  description: svc.desc,
  url: SITE.url + path,
  provider: { "@type": "Organization", name: "ShoreBridge BPO", url: SITE.url },
  areaServed: ["US", "BD"],
};
---
<Base title={svc.title} description={svc.desc} path={path} schema={[serviceSchema]}>
  <ServicePage svc={svc} />
</Base>
